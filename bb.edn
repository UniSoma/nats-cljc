;; Babashka task runner: a thin orchestration layer over the existing test/lint
;; commands (docs/agents/running-tests.md). bb only shells out — JVM tests and
;; shadow-cljs still run on the real JVM. `bb tasks` lists everything.
;;
;; Local dev runs the JVM + Node legs; the browser leg is CI-only (ADR 0010), so
;; `test` is jvm + node and `test:browser` is a CI-facing / opt-in wrapper.
{:tasks
 {test:jvm
  {:doc "JVM test leg — clojure -X:test (needs a ws-enabled nats-server)."
   :task (shell "clojure -X:test")}

  test:node
  {:doc "Node test leg — shadow-cljs compile + node (needs a ws-enabled nats-server)."
   :task (do (shell "npx shadow-cljs -A:silence-unsafe compile node")
             (shell "node target/node-tests.js"))}

  test:browser
  {:doc "Browser-headless leg — karma (CI-facing/opt-in; needs Chrome, honors $CHROME_BIN). Not part of `test` (ADR 0010)."
   :task (do (shell "npx shadow-cljs -A:silence-unsafe compile browser")
             (shell "npx karma start --single-run"))}

  test
  {:doc "Local legs: JVM + Node (browser is CI-only, ADR 0010)."
   :depends [test:jvm test:node]}

  lint
  {:doc "Lint src + test with clj-kondo."
   :task (shell "clj-kondo --lint src test")}

  externs:check
  {:doc "Externs gate — advanced compile of the whole cljs surface; fails on any infer-externs 'Cannot infer target type' warning. shadow exits 0 on that warning, so we grep. Local needs JDK 23+ (uses :silence-unsafe)."
   :requires ([babashka.process :as p]
              [clojure.string :as str])
   :task (let [{:keys [out err exit]}
               (p/shell {:out :string :err :string :continue true}
                        "npx shadow-cljs -A:silence-unsafe release externs-check")]
           (print out) (print err) (flush)
           (cond
             (str/includes? (str out err) "Cannot infer target type")
             (do (println "\nexterns:check FAILED — a JS-interop property access shadow can't type. Add a `^js` hint to the binding flagged above.")
                 (System/exit 1))
             (not (zero? exit))
             (System/exit exit)))}

  bundle:check
  {:doc "Bundle-isolation guard (ADR 0016) — release the core-only :core-bundle-check build and fail if the optimized bundle contains any @nats-io/jetstream bytes. Local needs JDK 23+ (uses :silence-unsafe)."
   :requires ([babashka.fs :as fs]
              [babashka.process :as p]
              [clojure.string :as str])
   :task (do (p/shell "npx shadow-cljs -A:silence-unsafe release core-bundle-check")
             (let [files (fs/glob "target/core-bundle-check" "*.js")
                   _     (when (empty? files)
                           (println "bundle:check FAILED — no JS output in target/core-bundle-check.")
                           (System/exit 1))
                   hits  (for [f     files
                               :let  [content (str/lower-case (slurp (fs/file f)))]
                               marker ["jetstream" "$js.api"]
                               :when (str/includes? content marker)]
                           (str (fs/file-name f) " contains \"" marker "\""))]
               (if (seq hits)
                 (do (println "\nbundle:check FAILED — the core-only bundle contains JetStream bytes:")
                     (doseq [h hits] (println "  " h))
                     (println "A [\"@nats-io/jetstream\"] import leaked into a core-reachable namespace (ADR 0016 keeps it confined to nats-cljc.jetstream impl namespaces).")
                     (System/exit 1))
                 (println "bundle:check OK — core-only bundle is JetStream-free."))))}

  pre_start
  {:doc "Start dev daemons (idempotent) — nREPL :7888 + the anon/token/users/jwt nats-servers. Backs `bb pre_start` in .aishell/config.yaml."
   :requires ([babashka.process :as p]
              [clojure.string :as str])
   :task (let [listening? (fn [port]
                            (try (.close (java.net.Socket. "127.0.0.1" (int port))) true
                                 (catch java.io.IOException _ false)))
               daemon     (fn [port cmd]
                            (if (listening? port)
                              (println (str "pre_start: :" port " already listening — skip"))
                              (do (println (str "pre_start: starting " (str/join " " cmd)))
                                  (p/process cmd {:out :inherit :err :inherit}))))]
           (daemon 7888 ["clojure" "-M:test:nrepl"])
           (daemon 4222 ["nats-server" "-c" "ci/nats.conf"])
           (daemon 4223 ["nats-server" "-c" "ci/nats-token.conf"])
           (daemon 4224 ["nats-server" "-c" "ci/nats-users.conf"])
           (daemon 4225 ["nats-server" "-c" "ci/nats-jwt.conf"]))}}}
