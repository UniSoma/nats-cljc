;; ClojureScript build. Classpath + deps come from deps.edn's :cljs alias.
{:deps {:aliases [:cljs]}

 :builds
 {;; Node test target: `shadow-cljs compile node` -> `node target/node-tests.js`
  :node
  {:target    :node-test
   :output-to "target/node-tests.js"
   :ns-regexp "-test$"}

  ;; Browser test target: runs cljs.test under headless Chrome via karma
  ;; (`shadow-cljs compile browser` -> `karma start --single-run`).
  :browser
  {:target    :karma
   :output-to "target/karma-test.js"
   :ns-regexp "-test$"
   :compiler-options {:output-feature-set :es-unsupported}}

  ;; Externs gate: an :advanced compile (alongside :core-bundle-check below). nats-cljc
  ;; ships as source, so the optimizing compile happens in each CONSUMER's build —
  ;; this repo's :none test compiles (node/browser) never run externs inference.
  ;; shadow infers most JS-interop accesses (it propagates `^js` through method/
  ;; property chains), but an access it CAN'T type — a `^js`-less binding with no
  ;; inferable source — has its property renamed silently under advanced, breaking
  ;; only in a consumer's release build, invisibly to this repo's CI. This build
  ;; compiles the whole public cljs surface under advanced purely to surface
  ;; shadow's infer-externs "Cannot infer target type" warning; the output bundle
  ;; is discarded. shadow exits 0 on that warning, so `bb externs:check` (and CI)
  ;; grep for it and fail. :entries IS the coverage manifest — the facades pull
  ;; their impl/protocol/error/stream deps transitively (each side-effect-requires
  ;; its per-leg impl, e.g. nats-cljc.jetstream.impl.js), and the opt-in codecs are
  ;; listed explicitly since nothing on the core path reaches them (ADR 0004).
  :externs-check
  {:target     :browser
   :output-dir "target/externs-check"
   :compiler-options {:infer-externs :auto}
   :modules {:main {:entries [nats-cljc.core
                              nats-cljc.jetstream
                              nats-cljc.kv
                              nats-cljc.service
                              nats-cljc.codec
                              nats-cljc.codec.json
                              nats-cljc.codec.transit]}}}

  ;; Bundle-isolation guard (ADR 0016): a core-only entry — nats-cljc.core and
  ;; nothing else — released to an optimized browser bundle. @nats-io/jetstream,
  ;; @nats-io/kv and @nats-io/services are declared unconditionally in
  ;; src/deps.cljs, but shadow only bundles an npm package that a reachable
  ;; namespace actually requires, so this bundle must contain zero JetStream, KV
  ;; or Services bytes. `bb bundle:check` (and CI) compiles this and scans the
  ;; output for JetStream/KV/Services markers; a hit means a ["@nats-io/jetstream"],
  ;; ["@nats-io/kv"] or ["@nats-io/services"] import leaked into a core-reachable
  ;; namespace (e.g. folded into nats-cljc.impl.js) and core-only consumers would
  ;; ship it.
  :core-bundle-check
  {:target     :browser
   :output-dir "target/core-bundle-check"
   :modules {:main {:entries [nats-cljc.core]}}}}}
