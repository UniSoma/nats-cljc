{:paths ["src"]

 :deps {org.clojure/clojure {:mvn/version "1.12.5"}
        io.nats/jnats        {:mvn/version "2.25.3"}
        funcool/promesa      {:mvn/version "11.0.678"}}

 :aliases
 {;; JVM tests: clj -X:test
  :test
  {:extra-paths ["test"]
   :extra-deps  {io.github.cognitect-labs/test-runner
                 {:git/tag "v0.5.1"
                  :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
   :main-opts   ["-m" "cognitect.test-runner"]
   :exec-fn     cognitect.test-runner.api/test}

  ;; ClojureScript toolchain (shadow-cljs reads this alias — see shadow-cljs.edn).
  :cljs
  {:extra-paths ["test"]
   :extra-deps  {org.clojure/clojurescript {:mvn/version "1.12.145"}
                 thheller/shadow-cljs      {:mvn/version "3.4.11"}}}

  ;; Build/jar: clj -T:build jar
  :build
  {:deps       {io.github.clojure/tools.build {:mvn/version "0.10.14"}}
   :ns-default build}}}
