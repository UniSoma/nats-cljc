{:paths ["src"]

 ;; Runtime deps only. promesa is NOT here on purpose (ADR 0002): the library
 ;; returns platform-native promises and never composes them internally, so it
 ;; forces no async dependency on consumers. promesa is a test/dev dep below.
 :deps {org.clojure/clojure {:mvn/version "1.12.5"}
        io.nats/jnats        {:mvn/version "2.25.3"}}

 :aliases
 {;; JVM tests: clj -X:test
  ;; promesa appears in test aliases only: the portable .cljc round-trip suite
  ;; awaits one-shot promises with it. Dev-scoped — never reaches the pom.
  :test
  {:extra-paths ["test"]
   ;; Silences JDK 24+ native-access warnings from jnats' BouncyCastle (Ed25519,
   ;; used by the nkey/JWT legs). Exists since JDK 16, so a no-op on CI's JDK 21.
   :jvm-opts    ["--enable-native-access=ALL-UNNAMED"]
   ;; transit-clj / data.json back the opt-in `:transit`/`:json` codecs. They are
   ;; test-scoped, never in `:deps` — a consumer who never requires those codec
   ;; namespaces needs neither (ADR 0004's clean forced footprint).
   :extra-deps  {io.github.cognitect-labs/test-runner
                 {:git/tag "v0.5.1"
                  :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}
                 funcool/promesa          {:mvn/version "11.0.678"}
                 com.cognitect/transit-clj {:mvn/version "1.1.357"}
                 org.clojure/data.json    {:mvn/version "2.5.2"}}
   :main-opts   ["-m" "cognitect.test-runner"]
   :exec-fn     cognitect.test-runner.api/test}

  ;; ClojureScript toolchain (shadow-cljs reads this alias — see shadow-cljs.edn).
  :cljs
  {:extra-paths ["test"]
   ;; transit-cljs backs the opt-in `:transit` codec on cljs (it pulls the
   ;; com.cognitect/transit-js classpath JS transitively). data.json is JVM-only
   ;; — the `:json` codec uses ambient js/JSON on cljs. Both test-scoped.
   :extra-deps  {org.clojure/clojurescript {:mvn/version "1.12.145"}
                 thheller/shadow-cljs      {:mvn/version "3.4.11"}
                 funcool/promesa           {:mvn/version "11.0.678"}
                 com.cognitect/transit-cljs {:mvn/version "0.8.280"}}}

  ;; Opt-in JVM flag for shadow-cljs runs (the bb test:node / test:browser tasks
  ;; layer it on with `-A:silence-unsafe`). shadow-cljs' bundled closure-compiler
  ;; calls deprecated sun.misc.Unsafe methods; JDK 23+ warns on first use, and
  ;; explicitly allowing it silences the warning. Kept OUT of :cljs on purpose:
  ;; the flag does not exist before JDK 23, so CI (JDK 21) — which runs plain
  ;; `npx shadow-cljs` without this alias — would reject it.
  :silence-unsafe
  {:jvm-opts ["--sun-misc-unsafe-memory-access=allow"]}

  ;; Build/jar: clj -T:build jar
  :build
  {:deps       {io.github.clojure/tools.build {:mvn/version "0.10.14"}}
   :ns-default build}

  ;; Dev nREPL: clojure -M:test:nrepl — a JVM Clojure nREPL on :7888 with jnats
  ;; (base dep) and the :test deps on the classpath, so JVM interop is checked at
  ;; a live REPL instead of cold-starting `clojure -M -e`. The dev container
  ;; launches this on entry (see .aishell/config.yaml).
  :nrepl
  {:extra-deps {nrepl/nrepl {:mvn/version "1.3.1"}}
   :main-opts  ["-m" "nrepl.cmdline" "--port" "7888"]}}}
